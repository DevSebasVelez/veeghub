// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
}

enum ProjectStatus {
  LEAD
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ReceivableStatus {
  PLANNED
  INVOICED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceStatus {
  READY_TO_SEND
  SENT
  PAID
  CANCELLED
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum CredentialKind {
  LOGIN
  OAUTH
  API_KEY
  DATABASE
  HOSTING
  SOCIAL_MEDIA
  EMAIL
  OTHER
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified DateTime?
  passwordHash  String
  role          UserRole @default(ADMIN)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([role])
}

model Client {
  id           String       @id @default(cuid())
  name         String
  legalName    String?
  taxId        String?
  email        String?
  billingEmail String?
  phone        String?
  website      String?
  address      String?
  notes        String?
  projects     Project[]
  receivables  Receivable[]
  invoices     Invoice[]
  credentials  Credential[]
  folders      DriveFolder[]
  files        DriveFile[]
  comments     Comment[]
  meetings     Meeting[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([name])
  @@index([taxId])
}

model Project {
  id            String       @id @default(cuid())
  name          String
  slug          String       @unique
  clientId      String?
  client        Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  status        ProjectStatus @default(ACTIVE)
  description   String?
  stack         String?
  repositoryUrl String?
  productionUrl String?
  stagingUrl    String?
  budget        Decimal?     @db.Decimal(12, 2)
  currency      String       @default("USD")
  startDate     DateTime?    @db.Date
  dueDate       DateTime?    @db.Date
  completedAt   DateTime?    @db.Date
  tasks         Task[]
  receivables   Receivable[]
  invoices      Invoice[]
  credentials   Credential[]
  folders       DriveFolder[]
  files         DriveFile[]
  comments      Comment[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([status, createdAt], map: "project_status_created_idx")
  @@index([clientId, status, createdAt], map: "project_client_status_created_idx")
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @db.Date
  completedAt DateTime?    @db.Date
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([dueDate])
  @@index([status, dueDate, createdAt], map: "task_status_due_created_idx")
  @@index([projectId, status, dueDate], map: "task_project_status_due_idx")
}

model Receivable {
  id          String           @id @default(cuid())
  clientId    String
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title       String
  description String?
  amount      Decimal          @db.Decimal(12, 2)
  paidAmount  Decimal          @default(0) @db.Decimal(12, 2)
  currency    String           @default("USD")
  dueDate     DateTime?        @db.Date
  status      ReceivableStatus @default(PLANNED)
  invoiceId   String?
  invoice     Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payments    Payment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@index([dueDate])
  @@index([invoiceId])
  @@index([status, dueDate, createdAt], map: "receivable_status_due_created_idx")
  @@index([clientId, status, dueDate], map: "receivable_client_status_due_idx")
  @@index([projectId, status, createdAt], map: "receivable_project_status_created_idx")
  @@index([invoiceId, status], map: "receivable_invoice_status_idx")
}

model Payment {
  id           String     @id @default(cuid())
  receivableId String
  receivable   Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  amount       Decimal    @db.Decimal(12, 2)
  paidAt       DateTime   @default(now()) @db.Date
  method       String?
  reference    String?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([receivableId])
  @@index([paidAt])
  @@index([paidAt, receivableId], map: "payment_paid_receivable_idx")
}

model Invoice {
  id            String          @id @default(cuid())
  clientId      String
  client        Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  receivables   Receivable[]
  invoiceNumber String?
  accessKey     String?         @unique
  subtotal      Decimal?        @db.Decimal(12, 2)
  taxAmount     Decimal?        @db.Decimal(12, 2)
  total         Decimal         @db.Decimal(12, 2)
  currency      String          @default("USD")
  issueDate     DateTime?       @db.Date
  status        InvoiceStatus   @default(READY_TO_SEND)
  xmlFileId     String?
  xmlFile       DriveFile?      @relation("InvoiceXmlFile", fields: [xmlFileId], references: [id], onDelete: SetNull)
  rideFileId    String?
  rideFile      DriveFile?      @relation("InvoiceRideFile", fields: [rideFileId], references: [id], onDelete: SetNull)
  emailLogs     EmailDelivery[]
  sentAt        DateTime?
  paidAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@index([issueDate])
  @@index([status, createdAt], map: "invoice_status_created_idx")
  @@index([clientId, createdAt], map: "invoice_client_created_idx")
  @@index([issueDate, status], map: "invoice_issue_status_idx")
}

model EmailDelivery {
  id                String    @id @default(cuid())
  invoiceId         String
  invoice           Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  to                String
  cc                String?
  subject           String
  body              String
  status            String    @default("SENT")
  providerMessageId String?
  error             String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())

  @@index([invoiceId])
  @@index([createdAt])
}

model DriveFolder {
  id        String        @id @default(cuid())
  name      String
  parentId  String?
  parent    DriveFolder?  @relation("DriveFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  DriveFolder[] @relation("DriveFolderTree")
  clientId  String?
  client    Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId String?
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  files     DriveFile[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([parentId])
  @@index([clientId])
  @@index([projectId])
  @@index([clientId, parentId, name], map: "drive_folder_client_parent_name_idx")
  @@index([projectId, parentId, name], map: "drive_folder_project_parent_name_idx")
  @@unique([parentId, name])
}

model DriveFile {
  id                String     @id @default(cuid())
  name              String
  objectKey         String     @unique
  mimeType          String
  size              Int
  folderId          String?
  folder            DriveFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  clientId          String?
  client            Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId         String?
  project           Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  invoiceXmlFor     Invoice[]  @relation("InvoiceXmlFile")
  invoiceRideFor    Invoice[]  @relation("InvoiceRideFile")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([folderId])
  @@index([clientId])
  @@index([projectId])
  @@index([folderId, name], map: "drive_file_folder_name_idx")
  @@index([clientId, folderId, name], map: "drive_file_client_folder_name_idx")
  @@index([projectId, folderId, name], map: "drive_file_project_folder_name_idx")
}

model Credential {
  id              String         @id @default(cuid())
  clientId        String?
  client          Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title           String
  kind            CredentialKind @default(LOGIN)
  url             String?
  username        String?
  accessMethod    String?
  encryptedSecret String?
  secretIv        String?
  secretTag       String?
  secretPreview   String?
  notes           String?
  lastViewedAt    DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([clientId])
  @@index([projectId])
  @@index([kind])
  @@index([updatedAt], map: "credential_updated_idx")
  @@index([clientId, updatedAt], map: "credential_client_updated_idx")
  @@index([projectId, updatedAt], map: "credential_project_updated_idx")
}

model Meeting {
  id        String        @id @default(cuid())
  title     String
  clientId  String?
  client    Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  startsAt  DateTime
  endsAt    DateTime
  meetLink  String?
  notes     String?
  status    MeetingStatus @default(SCHEDULED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([startsAt])
  @@index([clientId])
  @@index([status, startsAt], map: "meeting_status_starts_idx")
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([projectId])
}
